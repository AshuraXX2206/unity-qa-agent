# Unity QA Agent — environment overrides (optional).
# Prefer `qagent setup`, which stores config in ~/.qagent/config.yaml.
# Any key set here is used as a fallback if the config has none.

# ── AI provider keys (pick ONE provider in setup; free tiers) ──────────
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GROQ_API_KEY=            # https://console.groq.com/keys
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai/
MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys/
TOGETHER_API_KEY=        # https://api.together.ai/settings/api-keys

# Paid (most capable agent):
ANTHROPIC_API_KEY=       # https://console.anthropic.com/settings/keys

# ── Unity bridge ───────────────────────────────────────────────────────
UNITY_WS_URL=ws://localhost:8765
